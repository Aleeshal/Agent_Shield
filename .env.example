# AgentShield settings. Copy this file to .env and fill it in. NEVER commit .env.
# Full guide: docs/SETUP_AND_DEPLOYMENT.md
#
# Lines marked  >>> REQUIRED  must be filled in for real testing and deployment.
# Lines marked  >>> CHECK     already have a working default but should be verified.
# Everything else is optional.

# ---------------------------------------------------------------------------
# Nebius Token Factory (OpenAI-compatible API)
# ---------------------------------------------------------------------------

# >>> REQUIRED: your Nebius Token Factory API key (Token Factory console -> API keys)
NEBIUS_API_KEY=

# >>> CHECK: API base URL shown in the Token Factory docs / console
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# >>> CHECK: exact model ID as listed in Token Factory (must be an eligible NVIDIA model)
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: a different model for the judge and suggestions (blank = same as NEBIUS_MODEL)
NEBIUS_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Modes and tuning
# ---------------------------------------------------------------------------

# >>> CHECK: 1 = demo mode, fake replies, no key needed.  0 = real model calls (use for the real demo)
NEBIUS_MOCK=0

# 1 = ask reasoning models to answer directly. Set to 1 if real replies come back empty.
NEBIUS_DISABLE_THINKING=0

# Seconds before a model call times out
NEBIUS_TIMEOUT=60

# Tests run in parallel. Lower to 1-2 if you hit rate limits (HTTP 429).
AGENTSHIELD_CONCURRENCY=4

# SQLite file for saved runs (blank = agentshield.db in the project folder)
AGENTSHIELD_DB=
